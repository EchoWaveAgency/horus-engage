# Supabase project for HORUS Engage (its own project — not a client's database)
NEXT_PUBLIC_SUPABASE_URL=https://your-engage-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by: the Meta webhook, the runner it calls, the dispatcher job, sending an agent's logged reply.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://engage.echowave.example

# Meta app (one app for all clients — WhatsApp Cloud API + Messenger + Instagram)
META_APP_SECRET=            # App settings → Basic → App secret (webhook signature check)
META_VERIFY_TOKEN=          # any long random string; the same value in the Meta webhook settings
META_API_VERSION=v21.0
# META_MODE=dev             # LOCAL ONLY: log instead of calling Meta

# Scheduler calls POST /api/jobs/dispatch every minute with "Authorization: Bearer <CRON_SECRET>" (events to client systems)
CRON_SECRET=

# Optional: Claude reads free text the rules could not place (each client switches it on in Settings)
# ANTHROPIC_API_KEY=
# ENGAGE_AI_MODEL=claude-haiku-5-5

# Deploy on Vercel (Supabase integration injects NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY and POSTGRES_URL_NON_POOLING). The build then applies supabase/migrations once each.
ENGAGE_MIGRATE=on
# First run: an existing Supabase Auth user becomes the EchoWave platform admin; the first client org is created with draft services.
ENGAGE_ADMIN_EMAIL=
ENGAGE_FIRST_ORG=golden-care:Golden Care Clinics
